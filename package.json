{
  "name": "pg-column-tetris",
  "displayName": "PG Column Tetris",
  "description": "Lints PostgreSQL migration files for column ordering that wastes space due to alignment padding, and offers an auto-fix to reorder columns optimally.",
  "version": "0.1.0",
  "publisher": "engine",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "postgres",
    "postgresql",
    "sql",
    "migration",
    "linter",
    "column tetris",
    "alignment",
    "padding"
  ],
  "activationEvents": [
    "onLanguage:sql",
    "onLanguage:postgres",
    "onLanguage:mssql"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pgColumnTetris.checkFile",
        "title": "PG Column Tetris: Check Current File",
        "category": "PG Column Tetris"
      },
      {
        "command": "pgColumnTetris.checkWorkspace",
        "title": "PG Column Tetris: Check All Migration Files",
        "category": "PG Column Tetris"
      },
      {
        "command": "pgColumnTetris.fixTable",
        "title": "PG Column Tetris: Reorder Columns Optimally",
        "category": "PG Column Tetris"
      }
    ],
    "configuration": {
      "title": "PG Column Tetris",
      "properties": {
        "pgColumnTetris.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable PostgreSQL column-padding linting."
        },
        "pgColumnTetris.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "warning",
          "description": "Severity level for column padding diagnostics."
        },
        "pgColumnTetris.minWastedBytes": {
          "type": "number",
          "default": 1,
          "description": "Only report tables wasting at least this many bytes per row."
        },
        "pgColumnTetris.fileGlob": {
          "type": "string",
          "default": "**/*.sql",
          "description": "Glob pattern for SQL files to check via 'Check All Migration Files'."
        },
        "pgColumnTetris.runOn": {
          "type": "string",
          "enum": [
            "onType",
            "onSave",
            "manual"
          ],
          "default": "onType",
          "description": "When to run the linter: as you type, on save, or only on demand."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  }
}